# Placeholders only. Copy to .env for local runs outside Docker; never commit real values.
PORT=3000
HOST=127.0.0.1
# The API connects as the least-privilege role; migrations use the owner role (see deploy/).
DATABASE_URL=postgres://shopnest_app:PASSWORD@HOST:5432/DATABASE
APP_VERSION=0.1.0
GIT_SHA=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Database pool and timeout limits (milliseconds); defaults shown.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# Seeding is refused unless NODE_ENV is development or test (or ALLOW_PRODUCTION_SEED=true,
# which is for a deliberate, manually triggered run only). Never set it in a deployment.
# NODE_ENV=development
# Integration tests: a disposable database whose NAME MUST END IN "_test" (see
# deploy/docker-compose.test.yml). Each run uses its own throw-away schema.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55432/shopnest_test
