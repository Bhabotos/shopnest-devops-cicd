# Placeholders only. Copy to deploy/.env (git-ignored) and set your own local values.
# Use letters and digits only so a value can sit inside DATABASE_URL without encoding.
POSTGRES_PASSWORD=replace-with-local-admin-password
DB_OWNER_PASSWORD=replace-with-local-owner-password
DB_APP_PASSWORD=replace-with-local-app-password
APP_VERSION=dev
GIT_SHA=local
LOG_LEVEL=info
BACKEND_HOST_PORT=3100
FRONTEND_HOST_PORT=8080
