# Non-secret settings for the production environment, read by the blue/green scripts on the server.
# No passwords, addresses or keys belong here (those live in the server-side secrets.env).
HTTP_PORT=80
APP_VERSION=production
LOG_LEVEL=info
# Seconds to keep the previous colour running after traffic moved, so in-flight requests finish.
DRAIN_SECONDS=10
# How long a new colour has to become healthy and report the expected commit.
READY_ATTEMPTS=30
READY_INTERVAL=2
