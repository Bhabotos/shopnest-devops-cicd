# Non-secret settings for the staging environment, read by the blue/green scripts on the server.
# No passwords, keys or server addresses belong here. The database settings live in the server-side runtime.env;
# the container addresses below are private Docker-network addresses, not cloud addresses.
HTTP_PORT=8081
APP_VERSION=staging
LOG_LEVEL=info
# Seconds to keep the previous colour running after traffic moved, so in-flight requests finish.
DRAIN_SECONDS=10
# How long a new colour has to become healthy and report the expected commit.
READY_ATTEMPTS=30
READY_INTERVAL=2
# The container network (docs/AWS_STAGING_INTEGRATION.md, "Metadata protection"). ONE source of truth: Compose and
# deploy/host/imds-guard.sh both read these. The fixed addresses are outside EDGE_IP_RANGE, so no container that is
# assigned an address automatically can ever take one; only the two backend addresses may reach the metadata service.
# Each instance runs one environment, so the two environments use different ranges only to avoid confusion.
EDGE_NETWORK=shopnest-staging-edge
EDGE_SUBNET=172.29.10.0/24
EDGE_IP_RANGE=172.29.10.128/25
EDGE_GATEWAY=172.29.10.1
NGINX_IP=172.29.10.2
BACKEND_BLUE_IP=172.29.10.11
BACKEND_GREEN_IP=172.29.10.12
